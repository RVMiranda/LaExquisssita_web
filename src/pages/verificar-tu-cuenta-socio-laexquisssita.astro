---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Cuenta confirmada | La Exquisssita"
  description="Tu cuenta de socio de La Exquisssita ha sido confirmada. Ya puedes volver a la app."
  noIndex={true}
>
  <main class="confirmation-page" aria-labelledby="confirmation-title">
    <a class="confirmation-wordmark" href="/" aria-label="La Exquisssita, volver al sitio">
      <span class="wordmark-flower" aria-hidden="true"></span>
      <span>La Exquisssita</span>
    </a>

    <section class="confirmation-card" aria-describedby="confirmation-message">
      <div class="confirmation-seal" role="status" aria-label="Cuenta confirmada">
        <svg viewBox="0 0 64 64" aria-hidden="true" focusable="false">
          <circle class="seal-ring" cx="32" cy="32" r="27" />
          <path class="seal-check" d="m20 33 8 8 17-19" />
        </svg>
      </div>

      <p class="confirmation-eyebrow">Cuenta de socio</p>
      <h1 id="confirmation-title">¡Tu cuenta ha sido confirmada!</h1>
      <p id="confirmation-message" class="confirmation-message">
        Ya puedes volver a la app e iniciar sesión para consultar tu tarjeta de socio, llevar el registro de tus visitas y conocer las novedades, promociones y recompensas.
      </p>

      <div class="confirmation-benefits" aria-label="Lo que encontrarás en la app">
        <span>Tu tarjeta de socio</span>
        <span>Visitas y puntos</span>
        <span>Novedades y recompensas</span>
      </div>

      <a class="confirmation-button" href="/">Volver a La Exquisssita</a>
      <p class="confirmation-hint">Después, abre la app e inicia sesión para comenzar.</p>
    </section>

    <p class="confirmation-footer">Con gusto te esperamos.</p>
  </main>
</BaseLayout>

<style>
  .confirmation-page {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: max(28px, env(safe-area-inset-top)) 22px max(22px, env(safe-area-inset-bottom));
    color: var(--color-chocolate);
    background:
      radial-gradient(ellipse at 50% 43%, rgb(229 194 164 / 30%), transparent 58%),
      var(--color-vanilla);
    font-family: var(--font-body);
    text-align: center;
  }

  .confirmation-wordmark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--color-coffee);
    font-family: var(--font-brand);
    font-size: 37px;
    line-height: 1;
    text-decoration: none;
  }

  .confirmation-wordmark:focus-visible,
  .confirmation-button:focus-visible {
    outline: 3px solid var(--color-marigold);
    outline-offset: 5px;
    border-radius: 8px;
  }

  .wordmark-flower {
    width: 18px;
    height: 18px;
    flex: 0 0 18px;
    border-radius: 50%;
    background:
      radial-gradient(circle, var(--color-marigold) 0 2px, transparent 2.5px),
      radial-gradient(ellipse 3px 5px at 50% 0, var(--color-marigold) 90%, transparent 100%),
      radial-gradient(ellipse 3px 5px at 50% 100%, var(--color-marigold) 90%, transparent 100%),
      radial-gradient(ellipse 5px 3px at 0 50%, var(--color-marigold) 90%, transparent 100%),
      radial-gradient(ellipse 5px 3px at 100% 50%, var(--color-marigold) 90%, transparent 100%);
  }

  .confirmation-card {
    width: min(100%, 470px);
    margin: auto;
    padding: clamp(28px, 8vw, 46px) clamp(22px, 7vw, 42px);
    border: 1px solid rgb(126 57 47 / 12%);
    border-radius: 28px;
    background: rgb(255 252 245 / 94%);
    box-shadow: 0 22px 65px rgb(61 39 35 / 10%);
    animation: card-arrive 560ms cubic-bezier(.2, .8, .2, 1) both;
  }

  .confirmation-seal {
    width: 86px;
    height: 86px;
    margin: 0 auto 22px;
    color: var(--color-coffee);
  }

  .confirmation-seal svg { display: block; width: 100%; height: 100%; overflow: visible; }
  .seal-ring { fill: rgb(229 194 164 / 30%); stroke: var(--color-coffee); stroke-width: 1.7; }
  .seal-check {
    fill: none;
    stroke: var(--color-coffee);
    stroke-width: 3.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 38;
    stroke-dashoffset: 38;
    animation: draw-check 520ms 240ms ease-out forwards;
  }

  .confirmation-eyebrow {
    margin: 0 0 10px;
    color: var(--color-coffee);
    font-size: 17px;
    letter-spacing: .035em;
  }

  .confirmation-card h1 {
    max-width: 390px;
    margin: 0 auto 17px;
    color: var(--color-chocolate);
    font-family: var(--font-brand);
    font-size: clamp(46px, 12vw, 62px);
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.03;
  }

  .confirmation-message {
    margin: 0 auto 25px;
    color: #59423b;
    font-size: 18px;
    line-height: 1.55;
  }

  .confirmation-benefits {
    display: grid;
    gap: 8px;
    margin: 0 auto 26px;
    padding: 0;
    color: #59423b;
    font-size: 16px;
  }

  .confirmation-benefits span::before {
    content: '·';
    margin-right: 8px;
    color: var(--color-coffee);
    font-weight: 700;
  }

  .confirmation-button {
    min-height: 54px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px 20px;
    border-radius: 13px;
    background: var(--color-coffee);
    color: var(--color-paper);
    font-size: 17px;
    text-decoration: none;
    transition: transform 180ms ease, background-color 180ms ease;
  }

  .confirmation-button:hover { background: #652c25; transform: translateY(-1px); }
  .confirmation-button:active { transform: scale(.985); }
  .confirmation-hint { margin: 15px 0 0; color: #654b43; font-size: 15px; }
  .confirmation-footer { margin: 0; color: #765d53; font-size: 15px; }

  @keyframes card-arrive {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes draw-check { to { stroke-dashoffset: 0; } }

  @media (max-width: 380px) {
    .confirmation-page { padding-inline: 16px; }
    .confirmation-wordmark { font-size: 34px; }
    .confirmation-seal { width: 76px; height: 76px; margin-bottom: 18px; }
    .confirmation-message { font-size: 17px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .confirmation-card, .seal-check { animation: none; }
    .seal-check { stroke-dashoffset: 0; }
    .confirmation-button { transition: none; }
  }
</style>
