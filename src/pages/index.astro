---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import HistorySection from '../components/HistorySection.astro';
import LocationMap from '../components/LocationMap.astro';
import { business } from '../content/business';
---

<BaseLayout>
  <SiteHeader />
  <main>
    <section class="hero wrap" id="inicio" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow"><span class="eyebrow-dot" aria-hidden="true"></span> Carnitas · Ocosingo, Chiapas</p>
        <h1 id="hero-title">Se antojan unas carnitas.<br /><span>Se antoja La Exquisssita.</span></h1>
        <p class="hero-description">Conócenos en Ocosingo y consulta tu pedido para llevar.</p>
        <div class="hero-actions">
          <a class="button button-primary" href={business.whatsapp.href} target="_blank" rel="noreferrer">
            Consultar por WhatsApp <span aria-hidden="true">↗</span>
          </a>
          <a class="text-link" href="#visita">Planea tu visita <span aria-hidden="true">↓</span></a>
        </div>
        <p class="hero-footnote">Lunes a domingo · Desde las 8 de la mañana</p>
      </div>
      <div class="hero-art" aria-label="Ilustración de la mascota de La Exquisssita">
        <span class="art-ring art-ring-one" aria-hidden="true"></span>
        <span class="art-ring art-ring-two" aria-hidden="true"></span>
        <span class="art-label" aria-hidden="true">Hecho para antojar</span>
        <picture>
          <source srcset="/brand/mascota-bienvenida.webp" type="image/webp" />
          <img
            src="/brand/medio_cuerpo_2048.png"
            alt="Mascota de La Exquisssita, una cerdita con sombrero y canasta"
            width="2048"
            height="2048"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      </div>
      <span class="hero-index" aria-hidden="true">La bienvenida empieza antes de llegar</span>
    </section>

    <section class="about-section" id="nosotros" aria-labelledby="about-title">
      <div class="about-inner wrap">
        <div class="section-intro">
          <p class="eyebrow">Un gusto conocerte</p>
          <h2 id="about-title">{business.about.title}<span class="title-period">.</span></h2>
        </div>
        <div class="about-copy">
          <p>{business.about.text}</p>
          <a class="text-link" href="#visita">Encuentra aquí cómo visitarnos <span aria-hidden="true">↘</span></a>
        </div>
      </div>
    </section>

    <HistorySection history={business.history} />

    <section class="visit-section" id="visita" aria-labelledby="visit-title">
      <div class="visit-inner wrap">
        <div class="visit-heading">
          <p class="eyebrow">Aquí te esperamos</p>
          <h2 id="visit-title">Te esperamos<br /><span>en Ocosingo.</span></h2>
          <p>Encuentra el camino y ven a conocernos.</p>
          <a class="button button-primary" href={business.maps.href} target="_blank" rel="noreferrer">
            Abrir ubicación en Google Maps <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="visit-details">
          <div class="detail-block address-block">
            <p class="detail-label">Encuéntranos</p>
            <address>{business.address}</address>
          </div>
          <div class="detail-block hours-block">
            <p class="detail-label">Horario</p>
            <dl>
              {business.hours.map((row) => (
                <div class="hours-row">
                  <dt>{row.days}</dt>
                  <dd>{row.opens}–{row.closes}</dd>
                </div>
              ))}
            </dl>
          </div>
          <div class="detail-block phone-block">
            <p class="detail-label">Llámanos</p>
            <a href={business.phone.href}>{business.phone.display}</a>
          </div>
        </div>
        <div class="visit-map" aria-labelledby="map-title">
          <p class="detail-label">Ubicación</p>
          <h3 id="map-title">Cómo llegar</h3>
          <LocationMap src={business.maps.embed} title={`Mapa de ${business.maps.placeName} en Ocosingo`} />
        </div>
      </div>
      <div class="visit-decoration" aria-hidden="true"><span>Ocosingo</span></div>
    </section>

    <section class="app-section" id="app" aria-labelledby="app-title">
      <div class="app-inner wrap">
        <div class="app-copy">
          <p class="eyebrow">Un detalle para tu próxima visita</p>
          <h2 id="app-title">{business.app.title}<span class="title-period">.</span></h2>
          <p>{business.app.text}</p>
          <ul class="app-features">
            {business.app.features.map((feature) => (
              <li>
                <span class="feature-marker" aria-hidden="true"></span>
                <span><strong>{feature.title}</strong>{feature.description}</span>
              </li>
            ))}
          </ul>
        </div>
        <figure class="app-preview">
          <div class="app-device">
            <div class="app-screen">
              <div class="app-screen-heading">
                <span class="app-screen-brand">{business.name}</span>
                <span class="app-screen-intro">Un gusto tenerte cerca</span>
              </div>
              <section class="app-card app-card-loyalty" aria-label="Vista conceptual de tarjeta digital">
                <span class="app-card-kicker">Tarjeta digital</span>
                <span class="app-card-flower" aria-hidden="true"></span>
                <span class="app-card-copy">Preséntala<br />en caja</span>
              </section>
              <section class="app-card app-card-news" aria-label="Vista conceptual de novedades">
                <span class="app-card-kicker">Novedades</span>
                <span class="news-rule" aria-hidden="true"></span>
                <span class="app-news-title">Lo nuevo<br />de La Exquisssita</span>
              </section>
            </div>
          </div>
          <figcaption>Vista conceptual: marco de hasta 350 px de ancho, con cabecera, tarjeta digital y novedades. La pantalla mide al menos 480 px de alto; no es una captura ni especificación de la app real.</figcaption>
        </figure>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="footer-inner wrap">
      <a class="wordmark footer-wordmark" href="#inicio"><span class="wordmark-flower" aria-hidden="true"></span><span>{business.name}</span></a>
      <p>Carnitas en Ocosingo, Chiapas</p>
      <a href={business.phone.href}>{business.phone.display}</a>
      <span class="copyright">Con gusto te esperamos.</span>
    </div>
  </footer>
</BaseLayout>
